{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opentenbase.example/schemas/project2/structure-list-1.0.json",
  "title": "Project2 IVFFlat per-list structure record",
  "type": "object",
  "required": [
    "schema_version", "structure_schema_version", "diagnosis_id", "build_id",
    "timestamp_utc", "source", "availability", "reason", "record_type",
    "index_oid", "relfilenode", "sample_rate", "scan_scope", "sampling_method",
    "format_version", "dimensions", "declared_lists", "list_id",
    "list_page", "list_offset", "start_page", "insert_page", "entry_pages",
    "physical_tuple_count", "usable_bytes", "used_bytes", "free_bytes"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "structure_schema_version": {"const": "1.0"},
    "diagnosis_id": {"type": "string", "minLength": 1},
    "build_id": {"type": "string", "minLength": 1},
    "timestamp_utc": {"type": "string", "format": "date-time"},
    "source": {"const": "ivfflat_list_stats"},
    "availability": {"const": "available"},
    "reason": {"type": "null"},
    "record_type": {"const": "ivfflat_list"},
    "index_oid": {"type": "integer", "minimum": 1},
    "relfilenode": {"type": "integer", "minimum": 1},
    "sample_rate": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
    "scan_scope": {"enum": ["full", "sample"]},
    "sampling_method": {"enum": ["all_lists", "list_id_multiplicative_hash_v1"]},
    "format_version": {"type": "integer", "minimum": 1},
    "dimensions": {"type": "integer", "minimum": 1},
    "declared_lists": {"type": "integer", "minimum": 1},
    "list_id": {"type": "integer", "minimum": 0},
    "list_page": {"type": "integer", "minimum": 1},
    "list_offset": {"type": "integer", "minimum": 1},
    "start_page": {"type": ["integer", "null"], "minimum": 1},
    "insert_page": {"type": ["integer", "null"], "minimum": 1},
    "entry_pages": {"type": "integer", "minimum": 0},
    "physical_tuple_count": {"type": "integer", "minimum": 0},
    "usable_bytes": {"type": "integer", "minimum": 0},
    "used_bytes": {"type": "integer", "minimum": 0},
    "free_bytes": {"type": "integer", "minimum": 0}
  },
  "additionalProperties": true
}
