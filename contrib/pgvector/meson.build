      't/017_hnsw_filtering.pl',
      't/018_aggregates.pl',
      't/019_storage.pl',
      't/020_hnsw_bit_build_recall.pl',
      't/021_hnsw_bit_insert_recall.pl',
      't/022_hnsw_bit_vacuum_recall.pl',
      't/023_hnsw_bit_duplicates.pl',
      't/024_hnsw_halfvec_build_recall.pl',
      't/025_hnsw_halfvec_insert_recall.pl',
      't/026_hnsw_halfvec_vacuum_recall.pl',
      't/027_hnsw_halfvec_duplicates.pl',
      't/028_hnsw_sparsevec_build_recall.pl',
      't/029_hnsw_sparsevec_insert_recall.pl',
      't/030_hnsw_sparsevec_vacuum_recall.pl',
      't/031_hnsw_sparsevec_duplicates.pl',
      't/032_ivfflat_halfvec_build_recall.pl',
      't/033_comparison.pl',
      't/034_distance_functions.pl',
      't/035_ivfflat_bit_build_recall.pl',
      't/036_ivfflat_bit_centers.pl',
      't/037_inputs.pl',
      't/038_hnsw_sparsevec_vacuum_insert.pl',
      't/039_hnsw_cost.pl',
      't/040_ivfflat_cost.pl',
      't/041_ivfflat_iterative_scan.pl',
      't/042_ivfflat_iterative_scan_recall.pl',
      't/043_hnsw_iterative_scan.pl',
      't/044_hnsw_iterative_scan_recall.pl',
      't/045_hnsw_low_memory_build.pl',
      't/046_hnsw_vacuum_scan.pl',
      't/047_hnsw_vacuum_insert.pl',
      't/048_ivfflat_vacuum_insert.pl',
      't/049_hnsw_build_progress.pl',
      't/050_hnsw_memory_estimate.pl',
      't/051_vector_index_diagnose.pl',
      't/052_hnsw_parallel_build.pl',
      't/053_hnsw_diagnose_edges.pl',
    ],
  },
}
