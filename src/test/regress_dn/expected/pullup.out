                           ->  Seq Scan on sub1 c
                                 Filter: (c1 = b.c1)
           ->  Result
                 One-Time Filter: $2
                 ->  Hash Left Join
                       Hash Cond: (d_1.c1 = e_1.c1)
                       ->  Seq Scan on sub1 d_1
                       ->  Hash
                             ->  Seq Scan on sub1 e_1
   InitPlan 5 (returns $6)
     ->  Hash Left Join
           Hash Cond: (a_1.c3 = b_1.c3)
           Join Filter: (SubPlan 4)
           ->  CTE Scan on cte1 a_1
           ->  Hash
                 ->  CTE Scan on cte1 b_1
           SubPlan 4
             ->  Result
