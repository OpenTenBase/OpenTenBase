         Hash Cond: (d.c3 = a.c3)
         ->  Seq Scan on sub1 d
         ->  Hash
               ->  Seq Scan on sub1 a
   ->  Hash
         ->  Seq Scan on sub1 b
   SubPlan 2
     ->  Result
           One-Time Filter: (b.c1 = 1)
           ->  Seq Scan on sub1 c_1
                 Filter: (c1 = b.c1)
   SubPlan 3
     ->  Result
           One-Time Filter: (b.c1 = 1)
