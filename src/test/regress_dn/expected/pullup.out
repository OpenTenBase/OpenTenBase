where d.c2 = ( select (select c1 from sub1 c where b.c1 = 1 and c.c1 = d.c1) from sub1 a FULL JOIN sub1 b on EXISTS (select c1 from sub1 c where b.c1 = 1 and c.c1 = d.c1) and a.c3 = b.c3);
                                    QUERY PLAN                                    
----------------------------------------------------------------------------------
 Nested Loop Left Join
   Join Filter: (d.c1 = e.c1)
   ->  Seq Scan on sub1 d
         Filter: (c2 = (SubPlan 3))
         SubPlan 3
           ->  Nested Loop Left Scalar Join
                 Join Filter: (b.c1 = 1)
                 ->  Hash Full Join
                       Hash Cond: (a.c3 = b.c3)
                       Join Filter: (alternatives: SubPlan 1 or hashed SubPlan 2)
                       ->  Seq Scan on sub1 a
                       ->  Hash
                             ->  Seq Scan on sub1 b
                       SubPlan 1
                         ->  Result
                               One-Time Filter: (b.c1 = 1)
                               ->  Seq Scan on sub1 c
                                     Filter: (c1 = d.c1)
                       SubPlan 2
                         ->  Seq Scan on sub1 c_1
                               Filter: (c1 = d.c1)
                 ->  Materialize
                       ->  Seq Scan on sub1 c_2
                             Filter: (c1 = d.c1)
   ->  Materialize
         ->  Seq Scan on sub1 e
