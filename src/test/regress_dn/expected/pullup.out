select d.c1, d.c2, d.c3 from sub1 d INNER JOIN sub1 e ON d.c1 = e.c1
where not exists ( select (select f1(c1) from sub1 c where b.c1 = 1 and c.c1 = a.c1) from sub1 a INNER JOIN sub1 b on a.c1 NOT IN (select f1(c1) from sub1 c where b.c1 = 1 and c.c1 = b.c1) and a.c3 = b.c3))
select 1 from cte1 d INNER JOIN cte1 e ON d.c1 = e.c1
where d.c1 >= ( select (select f1(c1) from cte1 c where b.c1 = 1 and c.c1 = a.c1) from cte1 a INNER JOIN cte1 b on a.c1 NOT IN (select f1(c1) from cte1 c where b.c1 = 1 and c.c1 = b.c1) and a.c3 = b.c3)
;
                                                     QUERY PLAN                                                      
---------------------------------------------------------------------------------------------------------------------
 Hash Join
   Hash Cond: (e.c1 = d.c1)
   CTE cte1
     ->  Result
           One-Time Filter: (NOT $0)
           InitPlan 1 (returns $0)
             ->  Hash Anti Join
                   Hash Cond: (b.c1 = c.c1)
                   Join Filter: ((b.c1 = 1) AND ((a.c1 = f1(c.c1)) OR (a.c1 IS NULL) OR (f1(c.c1) IS NULL)))
                   ->  Nested Loop
                         Join Filter: (a.c3 = b.c3)
                         ->  Seq Scan on sub1 a
                         ->  Materialize
                               ->  Seq Scan on sub1 b
                   ->  Hash
                         ->  Seq Scan on sub1 c
           ->  Hash Join
                 Hash Cond: (d_1.c1 = e_1.c1)
                 ->  Seq Scan on sub1 d_1
                 ->  Hash
                       ->  Seq Scan on sub1 e_1
   InitPlan 3 (returns $2)
     ->  Hash Left Scalar Join
           Hash Cond: (a_1.c1 = c_2.c1)
           Join Filter: (b_1.c1 = 1)
           ->  Hash Anti Join
                 Hash Cond: (b_1.c1 = c_1.c1)
                 Join Filter: ((b_1.c1 = 1) AND ((a_1.c1 = f1(c_1.c1)) OR (a_1.c1 IS NULL) OR (f1(c_1.c1) IS NULL)))
                 ->  Hash Join
                       Hash Cond: (a_1.c3 = b_1.c3)
                       ->  CTE Scan on cte1 a_1
                       ->  Hash
                             ->  CTE Scan on cte1 b_1
                 ->  Hash
                       ->  CTE Scan on cte1 c_1
           ->  Hash
                 ->  CTE Scan on cte1 c_2
   ->  CTE Scan on cte1 e
   ->  Hash
         ->  CTE Scan on cte1 d
               Filter: (c1 >= $2)
(41 rows)

