where exists ( select (select f1(c1) from cte1 c where b.c1 = 1 and c.c1 = a.c1) from cte1 a LEFT JOIN cte1 b on a.c1 IN (select f1(c1) from cte1 c where b.c1 = 1 and c.c1 = b.c1) and a.c3 = b.c3)
