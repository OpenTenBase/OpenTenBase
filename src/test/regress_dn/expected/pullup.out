explain (costs off)
select 1 from sub1 a INNER JOIN sub1 b on a.c1 = (select c1 from sub1 c where b.c1 = 1 and c.c1 = b.c1) and a.c3 = b.c3;
                      QUERY PLAN                       
-------------------------------------------------------
 Hash Join
   Hash Cond: (((SubPlan 1) = a.c1) AND (b.c3 = a.c3))
   ->  Seq Scan on sub1 b
   ->  Hash
         ->  Seq Scan on sub1 a
   SubPlan 1
     ->  Result
           One-Time Filter: (b.c1 = 1)
           ->  Seq Scan on sub1 c
                 Filter: (c1 = b.c1)
(10 rows)

