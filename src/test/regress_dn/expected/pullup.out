                                 Filter: (c1 = b.c1)
           ->  Result
                 One-Time Filter: (NOT $2)
                 ->  Hash Full Join
                       Hash Cond: (d_1.c1 = e_1.c1)
                       ->  Seq Scan on sub1 d_1
                       ->  Hash
                             ->  Seq Scan on sub1 e_1
   InitPlan 5 (returns $6)
     ->  Hash Full Join
           Hash Cond: (a_1.c3 = b_1.c3)
           Join Filter: (NOT (SubPlan 4))
           ->  CTE Scan on cte1 a_1
           ->  Hash
                 ->  CTE Scan on cte1 b_1
           SubPlan 4
             ->  Result
                   One-Time Filter: (b_1.c1 = 1)
                   ->  CTE Scan on cte1 c_1
                         Filter: (c1 = b_1.c1)
   ->  Merge Full Join
         Merge Cond: (d.c1 = e.c1)
         ->  Sort
               Sort Key: d.c1
               ->  CTE Scan on cte1 d
         ->  Sort
               Sort Key: e.c1
               ->  CTE Scan on cte1 e
