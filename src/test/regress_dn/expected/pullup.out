select d.c1, d.c2, d.c3 from sub1 d INNER JOIN sub1 e ON d.c1 = e.c1
where d.c1 NOT IN ( select (select f1(c1) from sub1 c where b.c1 = 1 and c.c1 = a.c1) from sub1 a INNER JOIN sub1 b on exists (select f1(c1) from sub1 c where b.c1 = 1 and c.c1 = b.c1) and a.c3 = b.c3);
explain (costs off)
select 1 from v1 d INNER JOIN v1 e ON d.c1 = e.c1
where d.c1 NOT IN ( select (select f1(c1) from v1 c where b.c1 = 1 and c.c1 = a.c1) from v1 a INNER JOIN v1 b on exists (select f1(c1) from v1 c where b.c1 = 1 and c.c1 = b.c1) and a.c3 = b.c3);
                                                        QUERY PLAN                                                        
--------------------------------------------------------------------------------------------------------------------------
 Hash Join
   Hash Cond: (d.c1 = e.c1)
   ->  Hash Join
         Hash Cond: (d.c1 = e_1.c1)
         ->  Seq Scan on sub1 d
               Filter: ((NOT (hashed SubPlan 1)) AND (NOT (SubPlan 7)))
               SubPlan 1
                 ->  Hash Left Scalar Join
                       Hash Cond: (a.c1 = c_1.c1)
                       Join Filter: (b.c1 = 1)
                       ->  Hash Join
                             Hash Cond: (b.c3 = a.c3)
                             ->  Nested Loop
                                   ->  HashAggregate
                                         Group Key: c.c1
                                         ->  Seq Scan on sub1 c
                                               Filter: (c1 = 1)
                                   ->  Seq Scan on sub1 b
                                         Filter: (c1 = 1)
                             ->  Hash
                                   ->  Seq Scan on sub1 a
                       ->  Hash
                             ->  Seq Scan on sub1 c_1
               SubPlan 7
                 ->  Materialize
                       ->  Hash Left Scalar Join
                             Hash Cond: (d_2.c1 = d_5.c1)
                             Join Filter: (d_3.c1 = 1)
                             ->  Nested Loop
                                   ->  Hash Join
                                         Hash Cond: (d_2.c3 = d_3.c3)
                                         ->  Nested Loop
                                               ->  HashAggregate
                                                     Group Key: d_4.c1
                                                     ->  Nested Loop
                                                           ->  Seq Scan on sub1 e_4
                                                                 Filter: (c1 = 1)
                                                           ->  Materialize
                                                                 ->  Seq Scan on sub1 d_4
                                                                       Filter: ((NOT (hashed SubPlan 5)) AND (c1 = 1))
                                                                       SubPlan 5
                                                                         ->  Hash Left Scalar Join
                                                                               Hash Cond: (a_4.c1 = c_9.c1)
                                                                               Join Filter: (b_4.c1 = 1)
                                                                               ->  Hash Join
                                                                                     Hash Cond: (b_4.c3 = a_4.c3)
                                                                                     ->  Nested Loop
                                                                                           ->  HashAggregate
                                                                                                 Group Key: c_8.c1
                                                                                                 ->  Seq Scan on sub1 c_8
                                                                                                       Filter: (c1 = 1)
                                                                                           ->  Seq Scan on sub1 b_4
                                                                                                 Filter: (c1 = 1)
                                                                                     ->  Hash
                                                                                           ->  Seq Scan on sub1 a_4
                                                                               ->  Hash
                                                                                     ->  Seq Scan on sub1 c_9
                                               ->  Hash Join
                                                     Hash Cond: (e_2.c1 = d_2.c1)
                                                     ->  Seq Scan on sub1 e_2
                                                     ->  Hash
                                                           ->  Seq Scan on sub1 d_2
                                                                 Filter: (NOT (hashed SubPlan 3))
                                                                 SubPlan 3
                                                                   ->  Hash Left Scalar Join
                                                                         Hash Cond: (a_2.c1 = c_5.c1)
                                                                         Join Filter: (b_2.c1 = 1)
                                                                         ->  Hash Join
                                                                               Hash Cond: (b_2.c3 = a_2.c3)
                                                                               ->  Nested Loop
                                                                                     ->  HashAggregate
                                                                                           Group Key: c_4.c1
                                                                                           ->  Seq Scan on sub1 c_4
                                                                                                 Filter: (c1 = 1)
                                                                                     ->  Seq Scan on sub1 b_2
                                                                                           Filter: (c1 = 1)
                                                                               ->  Hash
                                                                                     ->  Seq Scan on sub1 a_2
                                                                         ->  Hash
                                                                               ->  Seq Scan on sub1 c_5
                                         ->  Hash
                                               ->  Seq Scan on sub1 d_3
                                                     Filter: ((NOT (hashed SubPlan 4)) AND (c1 = 1))
                                                     SubPlan 4
                                                       ->  Hash Left Scalar Join
                                                             Hash Cond: (a_3.c1 = c_7.c1)
                                                             Join Filter: (b_3.c1 = 1)
                                                             ->  Hash Join
                                                                   Hash Cond: (b_3.c3 = a_3.c3)
                                                                   ->  Nested Loop
                                                                         ->  HashAggregate
                                                                               Group Key: c_6.c1
                                                                               ->  Seq Scan on sub1 c_6
                                                                                     Filter: (c1 = 1)
                                                                         ->  Seq Scan on sub1 b_3
                                                                               Filter: (c1 = 1)
                                                                   ->  Hash
                                                                         ->  Seq Scan on sub1 a_3
                                                             ->  Hash
                                                                   ->  Seq Scan on sub1 c_7
                                   ->  Materialize
                                         ->  Seq Scan on sub1 e_3
                                               Filter: (c1 = 1)
                             ->  Hash
                                   ->  Hash Join
                                         Hash Cond: (d_5.c1 = e_5.c1)
                                         ->  Seq Scan on sub1 d_5
                                               Filter: (NOT (hashed SubPlan 6))
                                               SubPlan 6
                                                 ->  Hash Left Scalar Join
                                                       Hash Cond: (a_5.c1 = c_11.c1)
                                                       Join Filter: (b_5.c1 = 1)
                                                       ->  Hash Join
                                                             Hash Cond: (b_5.c3 = a_5.c3)
                                                             ->  Nested Loop
                                                                   ->  HashAggregate
                                                                         Group Key: c_10.c1
                                                                         ->  Seq Scan on sub1 c_10
                                                                               Filter: (c1 = 1)
                                                                   ->  Seq Scan on sub1 b_5
                                                                         Filter: (c1 = 1)
                                                             ->  Hash
                                                                   ->  Seq Scan on sub1 a_5
                                                       ->  Hash
                                                             ->  Seq Scan on sub1 c_11
                                         ->  Hash
                                               ->  Seq Scan on sub1 e_5
         ->  Hash
               ->  Seq Scan on sub1 e_1
   ->  Hash
         ->  Hash Join
               Hash Cond: (e.c1 = d_1.c1)
               ->  Seq Scan on sub1 e
               ->  Hash
                     ->  Seq Scan on sub1 d_1
                           Filter: (NOT (hashed SubPlan 2))
                           SubPlan 2
                             ->  Hash Left Scalar Join
                                   Hash Cond: (a_1.c1 = c_3.c1)
                                   Join Filter: (b_1.c1 = 1)
                                   ->  Hash Join
                                         Hash Cond: (b_1.c3 = a_1.c3)
                                         ->  Nested Loop
                                               ->  HashAggregate
                                                     Group Key: c_2.c1
                                                     ->  Seq Scan on sub1 c_2
                                                           Filter: (c1 = 1)
                                               ->  Seq Scan on sub1 b_1
                                                     Filter: (c1 = 1)
                                         ->  Hash
                                               ->  Seq Scan on sub1 a_1
                                   ->  Hash
                                         ->  Seq Scan on sub1 c_3
(153 rows)

drop view v1;
create view v1 as
select d.c1, d.c2, d.c3 from sub1 d INNER JOIN sub1 e ON d.c1 = e.c1
where d.c1 >= ( select (select f1(c1) from sub1 c where b.c1 = 1 and c.c1 = a.c1) from sub1 a INNER JOIN sub1 b on a.c1 = (select f1(c1) from sub1 c where b.c1 = 1 and c.c1 = b.c1) and a.c3 = b.c3);
explain (costs off)
select 1 from v1 d INNER JOIN v1 e ON d.c1 = e.c1
where d.c1 >= ( select (select f1(c1) from v1 c where b.c1 = 1 and c.c1 = a.c1) from v1 a INNER JOIN v1 b on a.c1 = (select f1(c1) from v1 c where b.c1 = 1 and c.c1 = b.c1) and a.c3 = b.c3);
                                                 QUERY PLAN                                                  
-------------------------------------------------------------------------------------------------------------
 Hash Join
   Hash Cond: (e.c1 = d.c1)
   InitPlan 2 (returns $1)
     ->  Hash Left Scalar Join
           Hash Cond: (a.c1 = c_1.c1)
           Join Filter: (b.c1 = 1)
           ->  Hash Join
                 Hash Cond: (((SubPlan 1) = a.c1) AND (b.c3 = a.c3))
                 ->  Seq Scan on sub1 b
                 ->  Hash
                       ->  Seq Scan on sub1 a
                 SubPlan 1
                   ->  Result
                         One-Time Filter: (b.c1 = 1)
                         ->  Seq Scan on sub1 c
                               Filter: (c1 = b.c1)
           ->  Hash
                 ->  Seq Scan on sub1 c_1
   InitPlan 4 (returns $3)
     ->  Hash Left Scalar Join
           Hash Cond: (a_1.c1 = c_3.c1)
           Join Filter: (b_1.c1 = 1)
           ->  Hash Join
                 Hash Cond: (((SubPlan 3) = a_1.c1) AND (b_1.c3 = a_1.c3))
                 ->  Seq Scan on sub1 b_1
                 ->  Hash
                       ->  Seq Scan on sub1 a_1
                 SubPlan 3
                   ->  Result
                         One-Time Filter: (b_1.c1 = 1)
                         ->  Seq Scan on sub1 c_2
                               Filter: (c1 = b_1.c1)
           ->  Hash
                 ->  Seq Scan on sub1 c_3
   InitPlan 14 (returns $13)
     ->  Nested Loop Left Scalar Join
           Join Filter: ((d_4.c1 = 1) AND (d_5.c1 = d_3.c1))
           InitPlan 6 (returns $5)
             ->  Hash Left Scalar Join
                   Hash Cond: (a_2.c1 = c_5.c1)
                   Join Filter: (b_2.c1 = 1)
                   ->  Hash Join
                         Hash Cond: (((SubPlan 5) = a_2.c1) AND (b_2.c3 = a_2.c3))
                         ->  Seq Scan on sub1 b_2
                         ->  Hash
                               ->  Seq Scan on sub1 a_2
                         SubPlan 5
                           ->  Result
                                 One-Time Filter: (b_2.c1 = 1)
                                 ->  Seq Scan on sub1 c_4
                                       Filter: (c1 = b_2.c1)
                   ->  Hash
                         ->  Seq Scan on sub1 c_5
           InitPlan 8 (returns $7)
             ->  Hash Left Scalar Join
                   Hash Cond: (a_3.c1 = c_7.c1)
                   Join Filter: (b_3.c1 = 1)
                   ->  Hash Join
                         Hash Cond: (((SubPlan 7) = a_3.c1) AND (b_3.c3 = a_3.c3))
                         ->  Seq Scan on sub1 b_3
                         ->  Hash
                               ->  Seq Scan on sub1 a_3
                         SubPlan 7
                           ->  Result
                                 One-Time Filter: (b_3.c1 = 1)
                                 ->  Seq Scan on sub1 c_6
                                       Filter: (c1 = b_3.c1)
                   ->  Hash
                         ->  Seq Scan on sub1 c_7
           InitPlan 13 (returns $12)
             ->  Hash Left Scalar Join
                   Hash Cond: (a_5.c1 = c_11.c1)
                   Join Filter: (b_5.c1 = 1)
                   ->  Hash Join
                         Hash Cond: (((SubPlan 12) = a_5.c1) AND (b_5.c3 = a_5.c3))
                         ->  Seq Scan on sub1 b_5
                         ->  Hash
                               ->  Seq Scan on sub1 a_5
                         SubPlan 12
                           ->  Result
                                 One-Time Filter: (b_5.c1 = 1)
                                 ->  Seq Scan on sub1 c_10
                                       Filter: (c1 = b_5.c1)
                   ->  Hash
                         ->  Seq Scan on sub1 c_11
           ->  Nested Loop
                 Join Filter: (d_4.c1 = e_4.c1)
                 ->  Nested Loop
                       Join Filter: ((e_3.c1 = d_3.c1) AND (d_4.c3 = d_3.c3))
                       ->  Hash Join
                             Hash Cond: ((SubPlan 11) = e_3.c1)
                             ->  Seq Scan on sub1 d_4
                                   Filter: (c1 >= $7)
                             ->  Hash
                                   ->  Seq Scan on sub1 e_3
                             SubPlan 11
                               ->  Result
                                     One-Time Filter: (d_4.c1 = 1)
                                     InitPlan 10 (returns $9)
                                       ->  Hash Left Scalar Join
                                             Hash Cond: (a_4.c1 = c_9.c1)
                                             Join Filter: (b_4.c1 = 1)
                                             ->  Hash Join
                                                   Hash Cond: (((SubPlan 9) = a_4.c1) AND (b_4.c3 = a_4.c3))
                                                   ->  Seq Scan on sub1 b_4
                                                   ->  Hash
                                                         ->  Seq Scan on sub1 a_4
                                                   SubPlan 9
                                                     ->  Result
                                                           One-Time Filter: (b_4.c1 = 1)
                                                           ->  Seq Scan on sub1 c_8
                                                                 Filter: (c1 = b_4.c1)
                                             ->  Hash
                                                   ->  Seq Scan on sub1 c_9
                                     ->  Nested Loop
                                           ->  Seq Scan on sub1 e_2
                                                 Filter: (c1 = d_4.c1)
                                           ->  Materialize
                                                 ->  Seq Scan on sub1 d_2
                                                       Filter: ((c1 >= $9) AND (c1 = d_4.c1))
                       ->  Materialize
                             ->  Seq Scan on sub1 d_3
                                   Filter: (c1 >= $5)
                 ->  Materialize
                       ->  Seq Scan on sub1 e_4
           ->  Materialize
                 ->  Hash Join
                       Hash Cond: (e_5.c1 = d_5.c1)
                       ->  Seq Scan on sub1 e_5
                       ->  Hash
                             ->  Seq Scan on sub1 d_5
                                   Filter: (c1 >= $12)
   ->  Hash Join
         Hash Cond: (e_1.c1 = e.c1)
         ->  Seq Scan on sub1 e_1
         ->  Hash
               ->  Hash Join
                     Hash Cond: (e.c1 = d_1.c1)
                     ->  Seq Scan on sub1 e
                     ->  Hash
                           ->  Seq Scan on sub1 d_1
                                 Filter: (c1 >= $3)
   ->  Hash
         ->  Seq Scan on sub1 d
               Filter: ((c1 >= $1) AND (c1 >= $13))
(145 rows)

drop view v1;
create view v1 as
select d.c1, d.c2, d.c3 from sub1 d LEFT JOIN sub1 e ON d.c1 = e.c1
where exists ( select (select f1(c1) from sub1 c where b.c1 = 1 and c.c1 = a.c1) from sub1 a LEFT JOIN sub1 b on a.c1 IN (select f1(c1) from sub1 c where b.c1 = 1 and c.c1 = b.c1) and a.c3 = b.c3);
explain (costs off)
select 1 from v1 d LEFT JOIN v1 e ON d.c1 = e.c1
where exists ( select (select f1(c1) from v1 c where b.c1 = 1 and c.c1 = a.c1) from v1 a LEFT JOIN v1 b on a.c1 IN (select f1(c1) from v1 c where b.c1 = 1 and c.c1 = b.c1) and a.c3 = b.c3);
                                 QUERY PLAN                                  
-----------------------------------------------------------------------------
 Result
   One-Time Filter: ($2 AND $17)
   InitPlan 2 (returns $2)
     ->  Hash Left Join
           Hash Cond: (a.c3 = b.c3)
           Join Filter: (SubPlan 1)
           ->  Seq Scan on sub1 a
           ->  Hash
                 ->  Seq Scan on sub1 b
           SubPlan 1
             ->  Result
                   One-Time Filter: (b.c1 = 1)
                   ->  Seq Scan on sub1 c
                         Filter: (c1 = b.c1)
   InitPlan 4 (returns $5)
     ->  Hash Left Join
           Hash Cond: (a_1.c3 = b_1.c3)
           Join Filter: (SubPlan 3)
           ->  Seq Scan on sub1 a_1
           ->  Hash
                 ->  Seq Scan on sub1 b_1
           SubPlan 3
             ->  Result
                   One-Time Filter: (b_1.c1 = 1)
                   ->  Seq Scan on sub1 c_1
                         Filter: (c1 = b_1.c1)
   InitPlan 12 (returns $17)
     ->  Result
           One-Time Filter: $8
           InitPlan 6 (returns $8)
             ->  Hash Left Join
                   Hash Cond: (a_2.c3 = b_2.c3)
                   Join Filter: (SubPlan 5)
                   ->  Seq Scan on sub1 a_2
                   ->  Hash
                         ->  Seq Scan on sub1 b_2
                   SubPlan 5
                     ->  Result
                           One-Time Filter: (b_2.c1 = 1)
                           ->  Seq Scan on sub1 c_2
                                 Filter: (c1 = b_2.c1)
           InitPlan 8 (returns $11)
             ->  Hash Left Join
                   Hash Cond: (a_3.c3 = b_3.c3)
                   Join Filter: (SubPlan 7)
                   ->  Seq Scan on sub1 a_3
                   ->  Hash
                         ->  Seq Scan on sub1 b_3
                   SubPlan 7
                     ->  Result
                           One-Time Filter: (b_3.c1 = 1)
                           ->  Seq Scan on sub1 c_3
                                 Filter: (c1 = b_3.c1)
           ->  Nested Loop Left Join
                 Join Filter: (d_3.c1 = e_3.c1)
                 ->  Hash Right Join
                       Hash Cond: (d_4.c3 = d_3.c3)
                       Join Filter: (SubPlan 11)
                       ->  Result
                             One-Time Filter: $11
                             ->  Nested Loop Left Join
                                   Join Filter: (d_4.c1 = e_4.c1)
                                   ->  Seq Scan on sub1 d_4
                                   ->  Materialize
                                         ->  Seq Scan on sub1 e_4
                       ->  Hash
                             ->  Seq Scan on sub1 d_3
                       SubPlan 11
                         ->  Result
                               One-Time Filter: ($14 AND (d_4.c1 = 1))
                               InitPlan 10 (returns $14)
                                 ->  Hash Left Join
                                       Hash Cond: (a_4.c3 = b_4.c3)
                                       Join Filter: (SubPlan 9)
                                       ->  Seq Scan on sub1 a_4
                                       ->  Hash
                                             ->  Seq Scan on sub1 b_4
                                       SubPlan 9
                                         ->  Result
                                               One-Time Filter: (b_4.c1 = 1)
                                               ->  Seq Scan on sub1 c_4
                                                     Filter: (c1 = b_4.c1)
                               ->  Hash Left Join
                                     Hash Cond: (d_2.c1 = e_2.c1)
                                     ->  Seq Scan on sub1 d_2
                                           Filter: (c1 = d_4.c1)
                                     ->  Hash
                                           ->  Seq Scan on sub1 e_2
                                                 Filter: (c1 = d_4.c1)
                 ->  Materialize
                       ->  Seq Scan on sub1 e_3
   ->  Hash Left Join
         Hash Cond: (d.c1 = e.c1)
         ->  Hash Right Join
               Hash Cond: (d_1.c1 = d.c1)
               ->  Result
                     One-Time Filter: $5
                     ->  Hash Left Join
                           Hash Cond: (d_1.c1 = e_1.c1)
                           ->  Seq Scan on sub1 d_1
                           ->  Hash
                                 ->  Seq Scan on sub1 e_1
               ->  Hash
                     ->  Seq Scan on sub1 d
         ->  Hash
               ->  Seq Scan on sub1 e
(106 rows)

