             ->  Hash Left Scalar Join
                   Hash Cond: (a_3.c1 = c_7.c1)
                   Join Filter: (b_3.c1 = 1)
                   ->  Hash Full Join
                         Hash Cond: (((SubPlan 7) = a_3.c1) AND (b_3.c3 = a_3.c3))
                         ->  Seq Scan on sub1 b_3
                         ->  Hash
