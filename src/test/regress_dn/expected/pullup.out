                   ->  CTE Scan on cte1 c_1
                         Filter: (c1 = b_1.c1)
   ->  Merge Left Join
         Merge Cond: (d.c1 = e.c1)
         ->  Sort
               Sort Key: d.c1
               ->  CTE Scan on cte1 d
         ->  Sort
               Sort Key: e.c1
               ->  CTE Scan on cte1 e
