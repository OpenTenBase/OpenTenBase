                                         ->  HashAggregate
                                               Group Key: c.c1, f1(c.c1)
                                               ->  Seq Scan on sub1 c
                                                     Filter: (c1 = 1)
                                         ->  Hash
                                               ->  Seq Scan on sub1 a
                       ->  Materialize
                             ->  Seq Scan on sub1 c_1
                                   Filter: (c1 = d.c1)
