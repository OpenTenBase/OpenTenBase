-- Test dirty reads (to be executed in two sessions) --
-- Session 1 --
BEGIN;
SET TRANSACTION ISOLATION LEVEL READ UNCOMMITTED;
SHOW transaction_isolation;
UPDATE test_table SET num = 0 WHERE id = 2;
--Connection 1 updated id=2 num to 0, but did not commit
-- Session 2 --
BEGIN;
SET TRANSACTION ISOLATION LEVEL READ UNCOMMITTED;
SHOW transaction_isolation;
SELECT * FROM test_table WHERE id = 2; -- Unsubmitted changes should not be visible
-- Session 1 --
ROLLBACK;
-- Session 2 --
SELECT * FROM test_table WHERE id = 2;
COMMIT;
-- Test non-repetitive reads (needs to be executed in two sessions) --
-- Session 1 --
BEGIN;
SET TRANSACTION ISOLATION LEVEL READ COMMITTED;
SHOW transaction_isolation;
SELECT * FROM test_table ORDER BY id;
-- Session 2 --
--modified data and committed
BEGIN;
SET TRANSACTION ISOLATION LEVEL READ COMMITTED;
UPDATE test_table SET num = 0 WHERE id = 2;
COMMIT;
-- Session 1 --
--Query the same data again
SELECT * FROM test_table ORDER BY id;
COMMIT;
-- Test phantom reads (needs to be executed in two sessions) --
-- Session 1 --
SET TRANSACTION ISOLATION LEVEL REPEATABLE READ;
SHOW transaction_isolation;
SELECT * FROM test_table ORDER BY id;
SELECT * FROM test_table WHERE id > 8 ORDER BY id;
-- Session 2 --
--inserted new data and committed
BEGIN;
SET TRANSACTION ISOLATION LEVEL REPEATABLE READ;
INSERT INTO test_table VALUES (11, 'K', 200);
COMMIT;
-- Session 1 --
--Query the same data Again
SELECT * FROM test_table WHERE id > 8 ORDER BY id;
COMMIT;
SELECT * FROM test_table ORDER BY id;
 id | name  | num  
----+-------+------
  2 | B     |  200
  4 | D     |  130
  5 | E     |  140
  6 | F     |  150
  7 | G     |  160
  8 | H     |  170
  9 | I     |  180
 10 | J     |  190
 12 | Node1 | 1011
 14 | Node2 | 1022
(10 rows)

