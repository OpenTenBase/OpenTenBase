create table sub1(c1 int, c2 int, c3 int, c4 CHARACTER(10), c5 CHARACTER(10));
insert into sub1 
    select  i, (i*53) % 93, (i*89) % 97, ((i*53) % 93)::CHARACTER(10), ((i*89) % 97)::CHARACTER(10)
    from generate_series(1, 1000) as i;
analyze;
explain (costs off)
select 1 from sub1 a INNER JOIN sub1 b on a.c1 IN (select c1 from sub1 c where b.c1 = 1 and c.c1 = b.c1) and a.c3 = b.c3;
                      QUERY PLAN                       
-------------------------------------------------------
 Remote Fast Query Execution Mode: fqs_mode_std_planer
   Node/s: datanode_1
   ->  Hash Join
         Hash Cond: (a.c3 = b.c3)
         ->  Nested Loop
               ->  HashAggregate
                     Group Key: c.c1, c.c1
                     ->  Seq Scan on sub1 c
                           Filter: (c1 = 1)
               ->  Seq Scan on sub1 a
                     Filter: (c1 = 1)
         ->  Hash
               ->  Seq Scan on sub1 b
                     Filter: (c1 = 1)
(14 rows)

explain (costs off)
select 1 from sub1 a INNER JOIN sub1 b on a.c1 IN (select c1 from sub1 c where b.c2 = 1 and c.c1 = b.c1) and a.c3 = b.c3;
                            QUERY PLAN                            
------------------------------------------------------------------
 Remote Fast Query Execution Mode: fqs_mode_std_planer
   Node/s: datanode_1, datanode_2
   ->  Hash Right Semi Join
         Hash Cond: (c.c1 = b.c1)
         ->  Seq Scan on sub1 c
         ->  Hash
               ->  Hash Join
                     Hash Cond: ((a.c3 = b.c3) AND (a.c1 = b.c1))
                     ->  Seq Scan on sub1 a
                     ->  Hash
                           ->  Seq Scan on sub1 b
                                 Filter: (c2 = 1)
(12 rows)

explain (costs off)
select 1 from sub1 a INNER JOIN sub1 b on a.c1 IN (select c2 from sub1 c where b.c2 = 1 and c.c1 = b.c1) and a.c3 = b.c3;
                         QUERY PLAN                          
-------------------------------------------------------------
 Remote Subquery Scan on all (datanodes 2)
   ->  Hash Join
         Hash Cond: ((a.c3 = b.c3) AND (a.c1 = c.c2))
         ->  Seq Scan on sub1 a
         ->  Hash
               ->  Remote Subquery Scan on all (datanodes 2)
                     Distribute results by H: c2
                     ->  Hash Join
                           Hash Cond: (c.c1 = b.c1)
                           ->  HashAggregate
                                 Group Key: c.c1, c.c2
                                 ->  Seq Scan on sub1 c
                           ->  Hash
                                 ->  Seq Scan on sub1 b
                                       Filter: (c2 = 1)
(15 rows)

