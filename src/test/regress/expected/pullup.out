where not exists ( select (select c1 from sub1 c where b.c1 = 1 and c.c1 = a.c1) from sub1 a LEFT JOIN sub1 b on a.c1 IN (select c1 from sub1 c where b.c1 = 1 and c.c1 = b.c1) and a.c3 = b.c3);
