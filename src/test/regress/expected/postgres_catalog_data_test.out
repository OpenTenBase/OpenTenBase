---------------+--------+----------+---------------+--------------+--------------+---------------+------------
 postgres      |     10 |        6 | f             | t            |           -1 |          1663 | p
 template0     |     10 |        6 | t             | f            |           -1 |          1663 | p
 template0_ora |     10 |        6 | t             | f            |           -1 |          1663 | o
(3 rows)

select oid, * from pg_user_mapping where oid < 16384;
 oid | umuser | umserver | umoptions 
-----+--------+----------+-----------
(0 rows)

select * from pg_shdescription where objoid < 10000 order by 1;
 objoid | classoid |                    description                     
--------+----------+----------------------------------------------------
      1 |     1262 | default template for new postgres databases
      2 |     1262 | default template for new opentenbase_ora databases
(2 rows)

select classoid, description from pg_shdescription where objoid > 10000 and objoid < 16384 order by 1, 2;
 classoid |                 description                 
----------+---------------------------------------------
     1262 | default administrative connection database
     1262 | unmodifiable empty opentenbase_ora database
     1262 | unmodifiable empty postgres database
(3 rows)

